# ============================================================
# Twikoo 2.0 测试环境变量清单（T10）
# 权威来源：twikoo-2.0-refactor-plan.md §9.4（共 23 个变量：A 类 14 + B 类 9）
#
# 使用方式：
#   1. 复制本文件为 .env（.gitignore 已排除，绝不入库）
#   2. 按需填充真实值——留空即「未配置」，对应用例自动 skip
#   3. pnpm env:check 查看当前已配置/缺失清单（信息报告，不拦截 CI）
#
# 优先级：CI 环境变量（GitHub Actions Secrets）> .env > 代码内默认值
# 加载：vitest setupFiles（根 test/setup/env.ts）测试启动时解析 .env，
#       仅对未设置的变量做 process.env 兜底。
# 判定：packages/shared/test/utils/env.ts 的 hasEnv()（空字符串视同未配置）。
# 硬规则：新增变量必须同步更新本文件（§9.4 机制要求 4）。
# ============================================================

# ---------- A 类 · 第三方密钥/账号（14 个）：缺失 → 对应真实外部用例 skip ----------

# 邮件 SMTP 服务器主机——缺失 → 邮件发送用例 skip
TEST_SMTP_HOST=
# 邮件 SMTP 端口——缺失 → 邮件发送用例 skip
TEST_SMTP_PORT=
# 邮件 SMTP 用户名——缺失 → 邮件发送用例 skip
TEST_SMTP_USER=
# 邮件 SMTP 密码/授权码——缺失 → 邮件发送用例 skip
TEST_SMTP_PASS=

# 推送通知渠道名（pushoo 支持 的渠道）——缺失 → 通知用例 skip
TEST_PUSHOO_CHANNEL=
# 推送通知渠道 token——缺失 → 通知用例 skip
TEST_PUSHOO_TOKEN=

# Akismet 反垃圾服务 key——缺失 → 反垃圾用例 skip
TEST_AKISMET_KEY=
# Akismet 反垃圾服务登记的博客地址——缺失 → 反垃圾用例 skip
TEST_AKISMET_BLOG=

# 腾讯云内容安全（TMS）SecretId——缺失 → 内容安全用例 skip
TEST_TENCENT_SECRET_ID=
# 腾讯云内容安全（TMS）SecretKey——缺失 → 内容安全用例 skip
TEST_TENCENT_SECRET_KEY=

# AI 生成接口 API Key——缺失 → AI 生成用例 skip
TEST_AI_API_KEY=
# AI 生成接口 Base URL（OpenAI 兼容端点）——缺失 → AI 生成用例 skip
TEST_AI_BASE_URL=

# 图床上传 token——缺失 → 图床用例 skip
TEST_IMAGE_BED_TOKEN=
# QQ 昵称接口地址——缺失 → QQ 昵称接口用例 skip
TEST_QQ_API_URL=

# ---------- B 类 · 运行时配置（9 个）：均有默认值，按需覆盖 ----------

# Mongo 契约测试连接串——有默认值：mongodb-memory-server 内存实例（不设则自动拉起内存库）
TEST_MONGODB_URI=
# Loki 测试数据目录——有默认值：系统临时目录
TEST_TWIKOO_DATA_DIR=
# demo / 集成测试端口——有默认值 9820
TEST_SERVER_PORT=
# 集成测试目标地址——有默认值 http://localhost:9820
TEST_BASE_URL=
# 日志级别（映射 TWIKOO_LOG_LEVEL）——有默认值 warn
TEST_LOG_LEVEL=
# 时区（影响 toCommentDto 时间断言）——有默认值 Asia/Shanghai
TEST_TIMEZONE=
# 语言区域（影响 i18n 断言）——有默认值 zh-CN
TEST_LOCALE=
# 管理员流程用例密码——有默认值：随机生成
TEST_ADMIN_PASSWORD=
# IP 头覆盖（映射 TWIKOO_IP_HEADERS）——有默认值：空
TEST_IP_HEADERS=
