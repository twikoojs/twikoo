# ============================================================
# Twikoo 2.0 测试环境变量清单
#
# 使用方式：
#   1. 复制本文件为 .env
#   2. 按需填充真实值——留空即「未配置」，对应用例自动 skip
#
# 优先级：CI 环境变量（GitHub Actions Secrets）> .env > 代码内默认值
# ============================================================

# 外部 Mongo 实例连接串，留空则用 mongodb-memory-server 内存实例
TEST_MONGODB_URI=

# 邮件 SMTP 服务器主机
TEST_SMTP_HOST=
# 邮件 SMTP 端口
TEST_SMTP_PORT=
# 邮件 SMTP 用户名
TEST_SMTP_USER=
# 邮件 SMTP 密码/授权码
TEST_SMTP_PASS=

# 推送通知渠道名（pushoo 支持的渠道）
TEST_PUSHOO_CHANNEL=
# 推送通知渠道 token
TEST_PUSHOO_TOKEN=

# Akismet 反垃圾服务 key
TEST_AKISMET_KEY=
# 站点地址（Akismet 校验 key 时登记的博客地址）
TEST_SITE_URL=

# 腾讯云内容安全（TMS）SecretId
TEST_QCLOUD_SECRET_ID=
# 腾讯云内容安全（TMS）SecretKey
TEST_QCLOUD_SECRET_KEY=

# AI 反垃圾 Base URL（OpenAI 兼容端点）
TEST_LLM_API_ENDPOINT=
# AI 反垃圾 API Key
TEST_LLM_API_KEY=
# AI 反垃圾模型名（可选；留空则用代码默认 deepseek-chat）
TEST_LLM_MODEL=

# 图床服务名或接口地址
TEST_IMAGE_CDN=
# 图床上传 token
TEST_IMAGE_CDN_TOKEN=
