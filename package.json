{
  "name": "twikoo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm run demo",
    "predemo": "pnpm run demo:build",
    "demo": "concurrently -k \"pnpm:demo:client\" \"pnpm:demo:server\" \"pnpm:demo:page\"",
    "demo:build": "pnpm -r --filter \"tkserver...\" --filter \"twikoo...\" run build",
    "demo:client": "pnpm --filter twikoo build:watch",
    "demo:server": "cross-env TWIKOO_DATA=../../data TWIKOO_SEED=1 pnpm --filter tkserver start",
    "demo:page": "pnpm --filter @twikoojs/demo dev",
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:md": "node scripts/format-md.mjs",
    "format:md": "node scripts/format-md.mjs --fix",
    "typecheck": "pnpm -r --if-present run typecheck",
    "e2e:b2": "node scripts/e2e-b2.mjs",
    "check:products": "node scripts/check-cdn-products.mjs"
  },
  "devDependencies": {
    "@twikoojs/tsdown-config": "workspace:*",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autocorrect-node": "^2.14.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.7",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43"
  }
}
