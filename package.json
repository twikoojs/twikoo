{
  "name": "twikoo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "echo \"TODO: wire up dev server in a later wave (T9)\"",
    "demo": "echo \"TODO: wire up demo in a later wave (T35)\"",
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "check:no-js": "node scripts/check-no-js-sources.mjs",
    "typecheck": "pnpm -r --if-present run typecheck",
    "prepare": "simple-git-hooks",
    "env:check": "node scripts/env-check.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.5.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "lint-staged": "^17.5.1",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.7",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.42"
  }
}
