{
  "name": "twikoo-edgeone-makers",
  "version": "0.0.0",
  "private": true,
  "description": "Twikoo comment system backend for Tencent EdgeOne Makers",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-ip2region-data.mjs",
    "check:size": "node scripts/check-eo-size.mjs",
    "check:ip2region": "node scripts/build-ip2region-data.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cap.js/server": "^4.0.5",
    "@edgeone/pages-blob": "latest",
    "@twikoojs/common": "workspace:*",
    "@twikoojs/shared": "workspace:*",
    "axios": "^1.20.0",
    "bowser": "^2.14.1",
    "form-data": "^4.0.6",
    "html-to-text": "^10.0.1",
    "marked": "^18.0.13",
    "pako": "^2.1.0",
    "pushoo": "workspace:^",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@imaegoo/node-ip2region": "^2.1.1",
    "@types/node": "^26.6.1"
  }
}
